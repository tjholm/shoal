# Copy to .env and adjust as needed. Loaded by dotenvx (see root package.json).

# --- Database ---
# Two options:
#
# 1. Local Postgres via `docker compose up` (recommended for dev):
DATABASE_URL=postgres://shoal:shoal@localhost:5432/shoal
#
# 2. Embedded PGlite (no compose, single-process dev). Same engine the
#    shoal-lite image uses — useful for offline work or quick experiments:
# DATABASE_URL=pglite://./data/pgdata

# --- Public URLs ---
# Defaults assume a portless setup at *.shoal.localhost. Override for any
# other host or for production deployments.
# SHOAL_APP_URL=https://web.shoal.localhost
# SHOAL_SERVER_URL=https://server.shoal.localhost

# Server listening port (default 3000).
# PORT=3000

# --- Email ---
# In development (NODE_ENV=development), invitation emails print to the
# console. For real delivery via Resend, set both:
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=invitations@yourdomain.com

# --- Worker ---
# Used by apps/worker if --token is not passed on the command line.
# Mint at /api-keys on the dashboard after signing in.
# SHOAL_TOKEN=sk_xxx

# --- Signup gate ---
# Public /sign-up endpoint. When unset (or false), signups are closed except
# for the very first user — first-user-wins bootstrap, so a fresh deployment
# always lets one admin in. Set to true for SaaS-style deployments where
# anyone can register. Invitation-based onboarding works regardless.
# SHOAL_ALLOW_SIGNUP=false

# --- Background tasks ---
# Set to false to disable the in-process scheduler (e.g. when an external
# cron / workflow engine drives the prune job instead).
# SHOAL_SCHEDULER_ENABLED=true
#
# Days to retain rows in usage_event. Older rows are deleted by the prune job.
# SHOAL_USAGE_RETENTION_DAYS=14
#
# Cron expression for the prune job. Default: top of every hour.
# SHOAL_USAGE_PRUNE_CRON=0 * * * *
