# Copy to .env and adjust as needed. Loaded by dotenvx (see root package.json).

# --- Database ---
# Postgres from `docker compose up -d postgres` (`bun run dev` starts it).
DATABASE_URL=postgres://shoal:shoal@localhost:5432/shoal

# --- Auth ---
# Signs sessions; at least 32 characters. Generate with `openssl rand -base64 32`.
# BETTER_AUTH_SECRET=  (required; the README setup step appends one)

# --- Public URLs ---
# Defaults assume a portless setup at *.shoal.localhost. Override for any
# other host or for production deployments.
# SHOAL_APP_URL=https://web.shoal.localhost
# SHOAL_SERVER_URL=https://server.shoal.localhost

# Server listening port (default 3000).
# PORT=3000
#
# Dashboard dev server only: where to proxy /api and /ws.
# SHOAL_API_URL=https://api.shoal.localhost
#
# Serve a built dashboard from the API (the Docker images set this).
# SHOAL_DASHBOARD_DIR=apps/dashboard/dist

# --- Email ---
# Invitation emails. By default they're printed to the server log, and the
# invite link can also be copied from the Members page. To send them:
# EMAIL_PROVIDER=resend
# EMAIL_RESEND_API_KEY=re_xxx
# EMAIL_FROM=Shoal <invitations@yourdomain.com>

# --- Worker ---
# Used by `shoal worker start` if --token is not passed on the command line.
# Create one on the API keys page of the dashboard.
# SHOAL_TOKEN=sk_xxx

# --- Migrations ---
# The Docker image applies pending migrations on start. Set to true when a
# deploy step migrates instead, or several instances share a database.
# SHOAL_SKIP_MIGRATIONS=false

# --- Signup gate ---
# Public /sign-up endpoint. When unset (or false), signups are closed except
# for the very first user — first-user-wins bootstrap, so a fresh deployment
# always lets one admin in. Set to true for SaaS-style deployments where
# anyone can register. Invitation-based onboarding works regardless.
# SHOAL_ALLOW_SIGNUP=false

# --- Background tasks ---
# Set to false to disable the in-process scheduler (e.g. when an external
# cron / workflow engine drives the prune job instead).
# SHOAL_SCHEDULER_ENABLED=true
#
# Days to retain rows in usage_event. Older rows are deleted by the prune job.
# SHOAL_USAGE_RETENTION_DAYS=14
#
# Cron expression for the prune job. Default: top of every hour.
# SHOAL_USAGE_PRUNE_CRON=0 * * * *

# Lets the desktop app trust portless's self-signed dev certificate.
# NODE_EXTRA_CA_CERTS=/home/<you>/.portless/ca.pem
