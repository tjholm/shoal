{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun-types"]
  },
  "include": ["apps/cli/**/*.ts", "packages/**/*.ts"],
  // A browser package with its own tsconfig.
  "exclude": ["packages/worker-ui"]
}
